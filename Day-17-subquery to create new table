*this subquery is used to create a new & consolidated dataset from which you can extract data.
* we use this technique when main query becomes too complex.
* Also we use it when we have to use new source of data repeatitively for different purposes also.

#Common Query
SELECT 
 column_1,
 column_2,..
FROM 
 (select 
  ...
  from table-1
  inner join table_2)
WHERE column_1 >100;

##Practice_Q_1
which users in the USA purchased atleast 50 songs?

SELECT *
FROM 
 (Select customer_id,
         last_name,
         country,
         state,
         count(invoice.customer_id) as no_of_purchases,
         round(sum(total),2) as total_purchased
         (select
               count(invoice_line.track_id) n_tracks
           from invoice_line
           inner join invoice on invoice.invoice_id= invoice_line.invoice_id
         Where invoice.customer_id= customer.customer_id) as count_tracks
  From customer
  inner join invoice on customer.customer_id = invoice.invoice_id
  group by 1,2,3,4
  order by 6 desc) as new_table
WHERE new_table.count_tracks >= 50
and new_table.country= 'USA'

##Practice_Q_2
find the number of users with atleast 50 songs purchases per state

SELECT state,
       count(*) 
 FROM
      (SELECT
            customer_id,
            last_name,
            country,
            state,
            count(invoice.customer_id) as no_of_purchases,
            round(sum(total),2) as total_purchased,
            (select 
                  count(invoice_line.track_id) as n_tracks
                  from invoice_line
                  inner join invoice on invoice.invoice_id= invoice_line.invoice_id
                  where invoice.customer_id= customer.customer_id) as count_tracks
         FROM customer
         INNER JOIN invoice on
         invoice.customer_id= customer.customer_id
         group by 1,2,3,4
         order by 6 desc) as new_table
    where new_table.count_tracks >=50
    and new_table.country= 'USA'
    GROUP BY new_table.state
   order by 2 DESC;

